{
    "name": "magmodules/magento2-reloadify",
    "description": "Reloadify extension for Magento 2",
    "type": "magento2-module",
    "version": "1.17.0",
    "license": [
        "BSD-2-Clause"
    ],
    "require": {
        "magento/framework": ">=100.1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "*"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Magmodules\\Reloadify\\": ""
        }
    },
    "extra": {
        "magmodules": {
            "module-name": {
                "en": "Reloadify",
                "nl": "Reloadify"
            },
            "links": {
                "product": {
                    "en": "https://www.magmodules.eu/magento2-reloadify.html",
                    "nl": "https://www.magmodules.nl/magento2-reloadify.html"
                },
                "docs": {
                    "en": "https://www.magmodules.eu/help/magento2-reloadify/",
                    "nl": "https://www.magmodules.nl/help/magento2-reloadify/"
                },
                "support": {
                    "en": "https://www.magmodules.eu/support/",
                    "nl": "https://www.magmodules.nl/support/"
                }
            }
        }
    }
}
