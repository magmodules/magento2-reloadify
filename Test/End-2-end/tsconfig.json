{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "Services/*": [
        "support/services/*"
      ],
      "Helpers/*": [
        "support/helpers/*"
      ],
      "Pages/*": [
        "support/pages/*"
      ],
      "Fixtures/*": [
        "support/fixtures/*"
      ]
    },
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "*.ts",
    "support/**/*.ts",
    "tests/**/*.ts"
  ]
}
